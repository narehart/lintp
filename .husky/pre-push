#!/bin/sh

echo "Running pre-push checks..."

# Run lint
echo "Running lint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Lint failed. Please fix lint errors before pushing."
  exit 1
fi

# Run type check
echo "Running type check..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Type check failed. Please fix type errors before pushing."
  exit 1
fi

# Run prettier check
echo "Running prettier check..."
npm run format:check
if [ $? -ne 0 ]; then
  echo "❌ Prettier check failed. Please format your code before pushing."
  exit 1
fi

# Run tests with the coverage gates (wireit caches, so an unchanged tree is
# near-instant). Needs cargo-llvm-cov: cargo install cargo-llvm-cov
echo "Running tests and coverage gates..."
npm run coverage
if [ $? -ne 0 ]; then
  echo "❌ Tests or coverage gates failed. Fix them before pushing."
  exit 1
fi

echo "✅ All pre-push checks passed!"